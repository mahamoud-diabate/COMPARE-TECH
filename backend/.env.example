# Copie ce fichier vers .env et renseigne les valeurs.
# Le .env ne doit JAMAIS etre commite (voir .gitignore).

# Chaine de connexion MongoDB Atlas
DB_URI=mongodb+srv://utilisateur:motdepasse@cluster.mongodb.net/comparetech

# --- Authentification admin (JWT) ---
# Nom du compte admin (defaut: "admin").
ADMIN_USERNAME=admin

# Mot de passe du compte admin (min. 10 caracteres). Sans lui, la connexion
# est desactivee et les routes d'ecriture renvoient 503 (fail-safe).
ADMIN_PASSWORD=

# Secret de signature des jetons JWT. Genere-le avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Cle Google AI Studio pour la route /api/ai/verdict (facultatif).
# Si absente, la route renvoie 503 et le reste de l'API fonctionne normalement.
GEMINI_API_KEY=

# Modele Gemini a utiliser (defaut: gemini-3.8-flash).
# Ex. gemini-2.5-flash pour un modele plus recent.
GEMINI_MODEL=gemini-3.8-flash

# Origines CORS SUPPLEMENTAIRES, separees par des virgules.
#
# Les domaines de production connus sont deja autorises en dur (voir
# backend/origines.js) : inutile de les repeter ici. Cette variable sert aux
# origines qui ne sont pas connues a l'avance — une URL de previsualisation
# Vercel, un domaine personnalise ajoute plus tard.
#
# Aucun motif n'est applique sur *.vercel.app : sur un domaine partage, un nom
# d'hote s'obtient au premier demandeur, donc un motif autoriserait des
# origines appartenant a des tiers. Une origine refusee est journalisee avec
# la marche a suivre.
#
# En developpement, les ports Vite locaux sont ajoutes automatiquement.
CORS_ORIGINS=

# Passer a "production" en deploiement : masque les details d'erreur
# et desactive les origines localhost par defaut.
NODE_ENV=development

# Port d'ecoute (Render le fournit automatiquement)
PORT=3001
